<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================================
     pom.xml - Descriptor Maven del backend reactivo (Práctica S11 | AP8)
     Spring Boot 3 + WebFlux + Spring Data Reactive MongoDB + Actuator.
     ========================================================================= -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM padre: gestiona las versiones de todas las dependencias de Spring Boot. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/> <!-- Se resuelve desde el repositorio, no desde el sistema de archivos local. -->
    </parent>

    <!-- Coordenadas Maven del proyecto. -->
    <groupId>com.practica</groupId>
    <artifactId>s11-backend-webflux</artifactId>
    <version>1.0.0</version>
    <name>s11-backend-webflux</name>
    <description>Backend reactivo (Spring WebFlux + MongoDB reactivo) para la Práctica S11 | AP8</description>

    <properties>
        <java.version>17</java.version> <!-- Versión mínima de Java exigida por Spring Boot 3. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Servidor reactivo (Netty) y API WebFlux: controladores con Mono y Flux. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Spring Data MongoDB en modo reactivo (ReactiveMongoRepository, driver reactive streams). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb-reactive</artifactId>
        </dependency>

        <!-- Actuator: expone /actuator/health, usado por las sondas liveness y readiness. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Validación de datos de entrada (@Valid, @NotBlank, @PositiveOrZero, ...). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- Nombre fijo del JAR generado: target/s11-backend.jar (lo usa el Dockerfile). -->
        <finalName>s11-backend</finalName>
        <plugins>
            <!-- Empaqueta la aplicación como "fat jar" ejecutable con java -jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
